{
  "name": "@sessionsight/feedback",
  "version": "1.0.4",
  "description": "User feedback and survey SDK for SessionSight.",
  "author": "SessionSight",
  "license": "MIT",
  "homepage": "https://sessionsight.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/SessionSight/sdks.git",
    "directory": "packages/feedback"
  },
  "bugs": {
    "url": "https://github.com/SessionSight/sdks/issues"
  },
  "keywords": [
    "feedback",
    "surveys",
    "user-feedback",
    "sessionsight"
  ],
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/client.d.ts",
    "dist/types.d.ts",
    "dist/integration-hint.d.ts"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./integration-hint": {
      "import": "./src/integration-hint.ts",
      "types": "./src/integration-hint.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./integration-hint": {
        "import": "./dist/integration-hint.js",
        "types": "./dist/integration-hint.d.ts"
      }
    }
  },
  "scripts": {
    "verify-hint": "bun run scripts/verify-hint.ts",
    "check-no-iife": "bun run scripts/check-no-iife.ts",
    "prebuild": "bun run verify-hint",
    "prepublishOnly": "bun run verify-hint && bun run check-no-iife",
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --format esm && bun x tsc --emitDeclarationOnly --declaration --outDir dist"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@sessionsight/sdk-shared": "workspace:*"
  }
}
